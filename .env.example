# Full DEV/control GET link from the organizers. Contains a signature: never commit it.
CQA_API_URL=

# claude_cli or openrouter
LLM_PROVIDER=claude_cli

# claude_cli model
LLM_MODEL=sonnet

# OpenRouter key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# schema for models with strict structured outputs, object for plain JSON mode
OPENROUTER_JSON_MODE=object

# Independent passes per evaluation
CQA_VOTES=3

# Team name for results/*/results.json
CQA_TEAM_NAME=
